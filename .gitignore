# NOTE: the outline and search tools also read this file with a simplified matcher.
# Keep patterns simple: no "!" negations, and write folders without a trailing "/"
# so they are excluded at any depth by both git and the outline.

# Python bytecode and caches
__pycache__
*.py[cod]
*$py.class

# Virtual environments
.venv
venv
env

# Packaging and build output
build
dist
*.egg-info
.eggs

# Test, lint and type-check caches
.pytest_cache
.mypy_cache
.ruff_cache
.tox
.coverage
htmlcov

# Local secrets and environment variables
.env

# Leftovers from interrupted atomic writes in the filesystem toolset
*.tmp

# Logs
*.log

# Editors and OS files
.vscode
.idea
.DS_Store
Thumbs.db

# Scripts that test the tools with a local model, kept only in the developer's own copy (see local_ai_test_results.md)
local_ai_tests

# Claude Code local settings
.claude/settings.local.json
